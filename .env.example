# Salin file ini jadi .env, lalu isi PROJECT_ID dengan nama unik kelompok.
# Dipakai oleh edge-audio/ dan processing-server/ (Python).
# Untuk esp32-firmware/, isi nilai yang sama di esp32-firmware/src/config.h

PROJECT_ID=guardsense_kelompok_XX

# Default: broker publik HiveMQ, tidak perlu akun.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
